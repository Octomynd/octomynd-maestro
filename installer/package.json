{
  "name": "@octomynd/maestro-setup",
  "private": true,
  "version": "0.4.2",
  "description": "Maestro Setup: a branded Windows bootstrapper that installs the Maestro desktop release with real progress.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
