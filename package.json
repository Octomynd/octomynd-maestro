{
  "name": "octomynd-maestro",
  "version": "0.4.2",
  "description": "Chat-first local orchestrator for Octomynd AI workflows.",
  "author": "Octomynd Contributors",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Octomynd/octomynd-maestro.git"
  },
  "bugs": {
    "url": "https://github.com/Octomynd/octomynd-maestro/issues"
  },
  "homepage": "https://docs.octomynd.com/en/",
  "keywords": [
    "ai-agents",
    "llm",
    "orchestration",
    "developer-tools",
    "electron",
    "typescript"
  ],
  "main": "src/desktop/main.cjs",
  "bin": {
    "maestro": "./src/cli/bin.cjs"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "setup": "tsx src/wizard.ts",
    "telegram:connect": "tsx src/telegram/connect.ts",
    "cli": "node scripts/ensure-node-native.mjs && tsx src/cli/index.ts",
    "cli:setup": "tsx src/cli/index.ts setup",
    "cli:telegram": "tsx src/cli/index.ts telegram connect",
    "cli:start": "tsx src/cli/index.ts start",
    "cli:restart": "tsx src/cli/index.ts restart",
    "cli:status": "tsx src/cli/index.ts status",
    "cli:desktop": "tsx src/cli/index.ts desktop",
    "dev": "tsx src/index.ts",
    "dev:api": "tsx watch src/dashboard/server-entry.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev:platform": "concurrently -k -n api,ui -c magenta,cyan \"npm:dev:api\" \"npm:dev:ui\"",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "rebuild:desktop-native": "node scripts/rebuild-desktop-native.mjs",
    "dist:win": "npm run rebuild:desktop-native && electron-builder --win --config electron-builder.yml",
    "release:win": "node scripts/build-desktop.mjs && npm run rebuild:desktop-native && electron-builder --win --config electron-builder.yml && npm run build:installer",
    "build:installer": "node scripts/build-installer.mjs",
    "verify:release": "node scripts/verify-desktop-release.mjs",
    "verify:release:github": "node scripts/verify-desktop-release.mjs --github",
    "postrelease:win": "node scripts/rebuild-test-native.mjs",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.6.2",
    "grammy": "^1.46.0",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.5.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "rcedit": "^5.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
